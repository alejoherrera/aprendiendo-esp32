# Los scripts de Windows necesitan fin de linea CRLF (cmd.exe falla con LF en algunos casos).
*.bat text eol=crlf
*.ps1 text eol=crlf
# Firmware precompilado: binario, sin conversiones.
*.bin binary
# Scripts de Mac/Linux: fin de linea LF (con CRLF, bash y perl fallan).
*.command text eol=lf
*.pl text eol=lf
*.sh text eol=lf
